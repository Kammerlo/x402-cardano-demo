{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "skipLibCheck": true,
    // The @x402/* deps are npm `file:` links into a pnpm workspace (see
    // ../x402/typescript). Without this, TS resolves imports made *inside*
    // those packages against their real pnpm-workspace location instead of
    // this project's node_modules, picking up a different (v5) @types/express
    // and producing false Request/Response type mismatches.
    "preserveSymlinks": true
  },
  "include": ["src"]
}
