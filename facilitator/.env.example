# REQUIRED. Free preprod project id from https://blockfrost.io — the facilitator
# uses it to check UTxOs, read protocol parameters, submit transactions, and
# authenticate settlement evidence (canonical block depth).
BLOCKFROST_PROJECT_ID=

# Optional overrides.
PORT=4022
CARDANO_NETWORK=cardano:preprod
BLOCKFROST_BASE_URL=https://cardano-preprod.blockfrost.io/api/v0

# Allows settling on authenticated MEMPOOL acceptance when the 402 asks for it
# (`confirmationPolicy.l1Confirmations: -1`). Off by default: a mempool
# transaction can still be rolled back, so the facilitator refuses it regardless
# of policy unless its operator opts in. Set to `true` to exercise the -1 end of
# the demo's "minimum blocks" slider — src/evidence.ts supplies the mempool
# evidence that setting needs, which the stock Blockfrost path cannot produce.
ACCEPT_MEMPOOL=false

# How long /settle waits for the requested block depth before answering
# `payment_pending`. Preprod blocks are ~20s, so the default covers the whole
# 0..20 range the spec allows.
# Published on GET /health so the resource server can size its own HTTP timeout
# above this. A resource server that gives up first turns a settling payment
# into an indeterminate failure — the buyer is told it failed while it settles.
CONFIRMATION_TIMEOUT_MS=480000

# NOTE: no mnemonic / private key. The facilitator holds no funds and signs
# nothing — the client's wallet pays the fee and signs the whole transaction;
# this service only reads chain state and broadcasts (in server-submission mode).
