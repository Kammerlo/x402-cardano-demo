# REQUIRED. Free preprod project id from https://blockfrost.io — the facilitator
# uses it to check UTxOs, read protocol parameters, and submit transactions.
BLOCKFROST_PROJECT_ID=

# Optional overrides.
PORT=4022
CARDANO_NETWORK=cardano:preprod
BLOCKFROST_BASE_URL=https://cardano-preprod.blockfrost.io/api/v0

# NOTE: no mnemonic / private key. The facilitator holds no funds and signs
# nothing — the client's wallet pays the fee and signs the whole transaction;
# this service only reads chain state and broadcasts.
