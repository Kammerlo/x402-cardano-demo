SERVER_CARDANO_ADDRESS=addr_test1...   # preprod address that receives payments

# REQUIRED. This demo ships no facilitator — point this at an x402 facilitator
# whose GET /supported advertises {scheme: "exact", network: "cardano:preprod"}.
# The server calls /supported at startup and refuses to serve the paid routes
# if that kind is missing, so a wrong/unreachable URL fails fast at boot.
FACILITATOR_URL=http://localhost:4022

PORT=4021

# The Masumi seller wallet. It SIGNS the terms (CIP-8 over `termsDigest`) and is
# the address the escrow pays out to, so a real deployment must set it. Unset
# falls back to the well-known BIP-39 test phrase so the demo runs out of the
# box; that key needs no funds — it only authorizes the terms.
MASUMI_SELLER_MNEMONIC=

# NOTE: there is no MASUMI_ESCROW_ADDRESS any more. The escrow address is
# DERIVED: the facilitator applies the deployment parameters to the canonical
# `vested_pay` blueprint and requires `payTo` to equal the result, so a
# stand-in address is rejected. The masumi routes therefore lock into the REAL
# preprod escrow — those funds are governed by the Masumi lifecycle and are not
# recoverable by simply spending the UTxO. Keep the amounts small.

# Optional. The native token the tUSDM routes charge in, as
# `policyId.assetNameHex`. Defaults to @x402/cardano's preprod tUSDM constant.
# More than one tUSDM-named token exists on preprod — set this to whichever
# one your wallet actually holds.
USDM_ASSET=

# Optional starting values for the demo controls; the frontend can change both
# at runtime via POST /demo/config. Both are checked against the facilitator's
# advertised capabilities at startup, and an unservable pair aborts the boot
# with the reason rather than 500ing on the first request.
#   SUBMISSION_POLICY  server | client | either
#     Default: `either` when the facilitator advertises it, so the frontend's
#     picker decides who broadcasts; otherwise the widest mode it does
#     advertise. The bundled facilitator offers all three.
#   L1_CONFIRMATIONS   -1..20
#     Default: the spec's 1, clamped into the facilitator's advertised range.
#     `-1` additionally needs ACCEPT_MEMPOOL=true on the facilitator.
SUBMISSION_POLICY=
L1_CONFIRMATIONS=

# Optional. How long to wait on a facilitator call. Leave empty: the server
# reads the facilitator's own settle budget from GET /health and adds a margin.
# The library's own 30s default is SHORTER than a single Cardano settlement
# (one confirmation is ~40s on preprod), and a client that gives up first
# reports a payment as failed that may well have settled.
FACILITATOR_TIMEOUT_MS=
